# (Asegúrate de usar 'base_limpia_corregida' aquí)
mapa_completo_corregido <- base_limpia_corregida %>%
st_as_sf(coords = c("LONGITUD_X", "LATITUD_Y"), crs = 4326)
# 3. Graficamos el mapa con el nuevo objeto corregido
mapa_ubic <- leaflet() %>%
addProviderTiles(providers$CartoDB.Positron) %>%
addGlPoints(
data = mapa_completo_corregido,  # <-- ¡CRUCIAL! Revisa que apunte a la versión corregida
fillColor = "darkred",
fillOpacity = 0.5,
radius = 3
)
# Mostrar el mapa corregido
mapa_ubic
base_limpia_corregida <- base_limpia %>%
filter(!(round(LONGITUD_X, 4) == -78.5400 &
FECHA >= "2024-06-18" &
FECHA <= "2024-06-24"))
# Volvemos a mapear
mapa_completo_corregido <- base_limpia_corregida %>%
st_as_sf(coords = c("LONGITUD_X", "LATITUD_Y"), crs = 4326)
mapa_ubic <- leaflet() %>%
addProviderTiles(providers$CartoDB.Positron) %>%
addGlPoints(
data = mapa_completo_corregido,
fillColor = "darkred",
fillOpacity = 0.5,
radius = 3
)
mapa_ubic
base_limpia_corregida <- base_limpia %>%
filter(!(
LONGITUD_X >= -78.5405 & LONGITUD_X <= -78.5395 &  # Tolerancia de ~10 metros
as.Date(FECHA) >= as.Date("2024-06-17") &          # Ampliado un día antes
as.Date(FECHA) <= as.Date("2024-06-25")            # Ampliado un día después
))
# Asegúrate de reescribir el objeto espacial con la base corregida
mapa_completo_corregido <- base_limpia_corregida %>%
st_as_sf(coords = c("LONGITUD_X", "LATITUD_Y"), crs = 4326)
mapa_ubic <- leaflet() %>%
addProviderTiles(providers$CartoDB.Positron) %>%
addGlPoints(
data = mapa_completo_corregido,
fillColor = "darkred",
fillOpacity = 0.5,
radius = 3
)
mapa_ubic
##### GUARDAR MAPAS
saveWidget(mapa_ubic, file = "mapa_puntos_siniestros.html", selfcontained = TRUE)
