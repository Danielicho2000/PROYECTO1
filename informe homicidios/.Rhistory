method = "intervals"
# Ya no necesitas definir 'r'
)
# Crear dataset con eventos declusterizados
excedencias_r <- excedencias %>%
mutate(
cluster_id = dl_object,
es_evento_principal = !is.na(cluster_id)
) %>%
filter(es_evento_principal == TRUE)
excedencias_int<-excedencias%>%
mutate(
cluster_id_int=dl_object_intervalos,
es_evento_principal_int=!is.na(cluster_id_int)
)%>%
filter(es_evento_principal_int == TRUE)
cat("Número de eventos después del declustering por rachas, r=3:", nrow(excedencias_r), "\n")
cat("Número de eventos después del declustering por intervalor:", nrow(excedencias_int), "\n")
rm("excedencias_declust_r", excedencias_declust_int)
# Filtrar excedencias para declustering
excedencias <- datos %>%
filter(magnitude > 5) %>%
arrange(time)
# Aplicar declustering por método de rachas
dl_object <- decluster(
x = excedencias$magnitude,
threshold = 5,
method = "runs",
r = 3
)
# Aplicar declustering por método de intervalos (Ferro & Segers, 2003)
dl_object_intervalos <- decluster(
x = excedencias$magnitude,
threshold = 5,
method = "intervals"
# Ya no necesitas definir 'r'
)
# Crear dataset con eventos declusterizados
excedencias_r <- excedencias %>%
mutate(
cluster_id = dl_object,
es_evento_principal = !is.na(cluster_id)
) %>%
filter(es_evento_principal == TRUE)
excedencias_int<-excedencias%>%
mutate(
cluster_id_int=dl_object_intervalos,
es_evento_principal_int=!is.na(cluster_id_int)
)%>%
filter(es_evento_principal_int == TRUE)
cat("Número de eventos después del declustering por rachas, r=3:", nrow(excedencias_r), "\n")
cat("Número de eventos después del declustering por intervalor:", nrow(excedencias_int), "\n")
excedencias_binarias <- as.numeric(datos$magnitude > 5)
#H0: son independientes los sismos
runs_test <- runs.test(factor(excedencias_binarias))
cat("=== PRUEBA DE RACHAS PARA INDEPENDENCIA ===\n")
cat("Estadístico:", round(runs_test$statistic, 4), "\n")
cat("p-valor:", round(runs_test$p.value, 4), "\n\n")
#<0.05 se rechaza la hipotesis nula
