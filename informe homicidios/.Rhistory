mapa_intenso <- leaflet() %>%
addProviderTiles(providers$CartoDB.DarkMatter) %>%
addHeatmap(
data = base_para_mapa,
lng = ~lng_map,
lat = ~lat_map,
# 1. INTENSIDAD: Usamos la variable de vecinos
intensity = ~n_vecinos_proximos,
# 2. DIFUMINADO Y RADIO: Aumentamos el radio para que las manchas sean más grandes
blur = 15,
radius = 15,
# 3. EL TRUCO DEL MAX:
# Si pones un valor menor al máximo real, los colores se saturan más rápido.
# Por ejemplo, si el máximo de vecinos es 20, pero pones max = 5,
# todo lo que tenga 5 o más vecinos se verá rojo intenso.
max = 5,
# 4. GRADIENTE: Aplicamos los colores definidos arriba
gradient = gradiente_intenso,
group = "Calor Intenso"
) %>%
# Añadir tus amenidades como puntos pequeños para que no tapen el calor
addCircleMarkers(
data = puntos, # Asegúrate de que 'puntos' esté en CRS 4326
color = "white",
radius = 1,
fillOpacity = 0.5,
stroke = FALSE,
label = ~amenity,
group = "Amenidades"
)
