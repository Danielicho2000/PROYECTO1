View(datos)
library(geosphere)
calc_dist_window <- function(m) { exp(-1.024 + 0.804 * m) }
calc_time_window <- function(m) { exp(-2.870 + 1.236 * m) }
# 2. Preparar el catálogo (DEBE ser el catálogo completo, no solo los > 5)
# Asumimos que tus columnas se llaman: time, lon, lat, magnitude
catalogo_ordenado <- datos %>%
# Ordenar de mayor a menor magnitud prioriza los sismos principales
arrange(desc(magnitude)) %>%
mutate(
is_mainshock = TRUE,
cluster_id = NA_integer_
)
n_eventos <- nrow(catalogo_ordenado)
# 3. Algoritmo de Declustering Iterativo
for (i in 1:n_eventos) {
# Si el evento ya fue marcado como réplica, lo saltamos
if (!catalogo_ordenado$is_mainshock[i]) next
mainshock <- catalogo_ordenado[i, ]
# Calcular el tamaño de la ventana para esta magnitud específica
D_km <- calc_dist_window(mainshock$magnitude)
T_days <- calc_time_window(mainshock$magnitude)
# Comparar contra el resto de eventos
for (j in 1:n_eventos) {
# Ignorar a sí mismo o a eventos que ya son réplicas
if (i == j || !catalogo_ordenado$is_mainshock[j]) next
# Calcular diferencia de tiempo en días (buscamos eventos que ocurrieron DESPUÉS)
dt <- as.numeric(difftime(catalogo_ordenado$time[j], mainshock$time, units = "days"))
# Si ocurrió antes del mainshock o fuera de la ventana de tiempo, se ignora
if (dt < 0 || dt > T_days) next
# Calcular distancia espacial en kilómetros (Haversine)
dist_km <- distHaversine(
c(mainshock$lon, mainshock$lat),
c(catalogo_ordenado$lon[j], catalogo_ordenado$lat[j])
) / 1000
# Si está dentro del radio espacial, se marca como réplica
if (dist_km <= D_km) {
catalogo_ordenado$is_mainshock[j] <- FALSE
catalogo_ordenado$cluster_id[j] <- i # Registramos de quién es réplica
}
}
}
# 1. Definir las leyes de escala para las ventanas empíricas
# Nota: Estas son las ecuaciones generales de Uhrhammer (1986).
# D(M) en km, T(M) en días.
calc_dist_window <- function(m) { exp(-1.024 + 0.804 * m) }
calc_time_window <- function(m) { exp(-2.870 + 1.236 * m) }
# 2. Preparar el catálogo (DEBE ser el catálogo completo, no solo los > 5)
# Asumimos que tus columnas se llaman: time, lon, lat, magnitude
catalogo_ordenado <- datos %>%
# Ordenar de mayor a menor magnitud prioriza los sismos principales
arrange(desc(magnitude)) %>%
mutate(
is_mainshock = TRUE,
cluster_id = NA_integer_
)
n_eventos <- nrow(catalogo_ordenado)
# 3. Algoritmo de Declustering Iterativo
for (i in 1:n_eventos) {
# Si el evento ya fue marcado como réplica, lo saltamos
if (!catalogo_ordenado$is_mainshock[i]) next
mainshock <- catalogo_ordenado[i, ]
# Calcular el tamaño de la ventana para esta magnitud específica
D_km <- calc_dist_window(mainshock$magnitude)
T_days <- calc_time_window(mainshock$magnitude)
# Comparar contra el resto de eventos
for (j in 1:n_eventos) {
# Ignorar a sí mismo o a eventos que ya son réplicas
if (i == j || !catalogo_ordenado$is_mainshock[j]) next
# Calcular diferencia de tiempo en días (buscamos eventos que ocurrieron DESPUÉS)
dt <- as.numeric(difftime(catalogo_ordenado$time[j], mainshock$time, units = "days"))
# Si ocurrió antes del mainshock o fuera de la ventana de tiempo, se ignora
if (dt < 0 || dt > T_days) next
# Calcular distancia espacial en kilómetros (Haversine)
dist_km <- distHaversine(
c(mainshock$lon, mainshock$lat),
c(catalogo_ordenado$lon[j], catalogo_ordenado$lat[j])
) / 1000
# Si está dentro del radio espacial, se marca como réplica
if (dist_km <= D_km) {
catalogo_ordenado$is_mainshock[j] <- FALSE
catalogo_ordenado$cluster_id[j] <- i # Registramos de quién es réplica
}
}
}
