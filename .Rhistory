base_limpia <- base %>%
mutate(
fecha_infraccion = as.Date(fecha_infraccion, format = "%Y/%m/%d"),
x_num = as.numeric(gsub(",", ".", as.character(coordenada_x))),
y_num = as.numeric(gsub(",", ".", as.character(coordenada_y)))
) %>%
filter(!is.na(x_num) & !is.na(y_num) & x_num != 0 & y_num != 0)
base<-bind_rows(base_1,base_2)
base_limpia <- base %>%
mutate(
fecha_infraccion = as.Date(fecha_infraccion, format = "%Y/%m/%d"),
x_num = as.numeric(gsub(",", ".", as.character(coordenada_x))),
y_num = as.numeric(gsub(",", ".", as.character(coordenada_y)))
) %>%
filter(!is.na(x_num) & !is.na(y_num) & x_num != 0 & y_num != 0)
# Grupo A: Las que YA están en grados (Lat/Lon). Sus valores X son negativos (ej. -78)
base_latlon <- base_limpia %>%
filter(x_num < 0) %>%
rename(longitud = x_num, latitud = y_num)
# Grupo B: Las que están en UTM. Sus valores X son positivos y grandes (ej. 500000)
base_utm <- base_limpia %>%
filter(x_num > 0) %>%
# Convertimos este grupo a objeto espacial UTM (32717) y lo pasamos a Lat/Lon (4326)
st_as_sf(coords = c("x_num", "y_num"), crs = 32717) %>%
st_transform(crs = 4326) %>%
mutate(
longitud = st_coordinates(.)[,1],
latitud = st_coordinates(.)[,2]
) %>%
st_drop_geometry() # Quitamos el formato espacial para poder unirla con el Grupo A
# 3. UNIR Y FILTRAR
# Juntamos las dos bases ya estandarizadas y aplicamos tu filtro espacial de seguridad
base_mod <- bind_rows(base_latlon, base_utm) %>%
filter(longitud > -82 & longitud < -75) %>%
filter(latitud > -6 & latitud < 2)
# 4. RECALCULAR TU GRÁFICO
conteo_mensual <- base_mod %>%
mutate(mes_año = floor_date(fecha_infraccion, "month")) %>%
group_by(mes_año) %>%
summarise(total_eventos = n(), .groups = 'drop')
ggplot(conteo_mensual, aes(x = mes_año, y = total_eventos)) +
geom_line(color = "steelblue", size = 1) +
geom_point(color = "darkblue", size = 1.5) +
geom_vline(xintercept = as.numeric(as.Date("2026-01-01")),
linetype = "dashed",
color = "red",
size = 1) +
labs(title = "Evolución Mensual de Homicidios (2014 - 2026)",
subtitle = "Validación de empalme entre bases históricas y recientes",
x = "Mes y Año",
y = "Total de Homicidios Mensuales") +
theme_minimal()
