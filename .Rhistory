base_sf <- st_as_sf(base_mod, coords = c("longitud", "latitud"), crs = 4326) %>%
st_transform(32717)
base_sf <- base_mod %>%
mutate(event_id = row_number()) %>%
st_as_sf(coords = c("longitud", "latitud"), crs = 4326)
base_con_vecinos<-base_sf %>%
mutate(
n_vecinos_proximos = sapply(1:n(), function(i) {
# Punto actual
punto <- base_sf[i, ]
# Filtrar potenciales vecinos:
# Mismo circuito (opcional para velocidad) y dentro del rango de tiempo
vecinos <- base_sf %>%
filter(
event_id != actual$event_id,
fecha_infraccion > actual$fecha_infraccion,
fecha_infraccion <= (actual$fecha_infraccion + days(tiempo_umbral))
)
if(nrow(vecinos) == 0) return(0)
distancias <- st_distance(actual, vecinos)
sum(as.numeric(distancias) <= distancia_umbral)
})
)
base_con_vecinos<-base_sf %>%
mutate(
n_vecinos_proximos = sapply(1:n(), function(i) {
# Punto actual
actual <- base_sf[i, ]
# Filtrar potenciales vecinos:
# Mismo circuito (opcional para velocidad) y dentro del rango de tiempo
vecinos <- base_sf %>%
filter(
event_id != actual$event_id,
fecha_infraccion > actual$fecha_infraccion,
fecha_infraccion <= (actual$fecha_infraccion + days(tiempo_umbral))
)
if(nrow(vecinos) == 0) return(0)
distancias <- st_distance(actual, vecinos)
sum(as.numeric(distancias) <= distancia_umbral)
})
)
distancia_umbral <- 500  # metros
tiempo_umbral <- 30
base_sf <- base_mod %>%
mutate(event_id = row_number()) %>%
st_as_sf(coords = c("longitud", "latitud"), crs = 4326)
base_con_vecinos<-base_sf %>%
mutate(
n_vecinos_proximos = sapply(1:n(), function(i) {
# Punto actual
actual <- base_sf[i, ]
# Filtrar potenciales vecinos:
# Mismo circuito (opcional para velocidad) y dentro del rango de tiempo
vecinos <- base_sf %>%
filter(
event_id != actual$event_id,
fecha_infraccion > actual$fecha_infraccion,
fecha_infraccion <= (actual$fecha_infraccion + days(tiempo_umbral))
)
if(nrow(vecinos) == 0) return(0)
distancias <- st_distance(actual, vecinos)
sum(as.numeric(distancias) <= distancia_umbral)
})
)
View(base_con_vecinos)
summary(base_con_vecinos$n_vecinos_proximos)
analisis_motivacion <- base_con_vecinos %>%
st_drop_geometry() %>%
group_by(presunta_motivacion) %>%
summarise(
promedio_seguidores = mean(n_vecinos_proximos),
total_eventos = n()
) %>%
arrange(desc(promedio_seguidores))
print(analisis_motivacion)
analisis_motivacion <- base_con_vecinos %>%
st_drop_geometry() %>%
group_by(presunta_motivacion) %>%
summarise(
promedio_vecinos_afectados = mean(n_vecinos_proximos),
total_eventos = n()
) %>%
arrange(desc(promedio_vecinos_afectados))
print(analisis_motivacion)
analisis_motivacion <- base_con_vecinos %>%
st_drop_geometry() %>%
group_by(distrito, presunta_motivacion) %>%
summarise(
promedio_vecinos_afectados = mean(n_vecinos_proximos),
max=max(n_vecinos_proximos, na.rm = TRUE),
prob=(sum(n_vecinos_proximos>0)/n())*100,
.groups='drop'
) %>%
filter(total_eventos >= 5) %>%
arrange(desc(prob))
analisis_motivacion <- base_con_vecinos %>%
st_drop_geometry() %>%
group_by(distrito, presunta_motivacion) %>%
summarise(
