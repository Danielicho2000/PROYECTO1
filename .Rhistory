base_exportar <- base_mod %>%
select(
# 1. Coordenadas y Tiempo (Tus requisitos principales)
longitud,
latitud,
fecha_infraccion,
hora_infraccion,
# 2. Variables de contexto territorial (para agrupar si no usas mapas)
provincia,
canton,
distrito,
circuito,
# 3. Variables del delito
tipo_muerte,
arma,
presunta_motivacion,
lugar,
# 4. Variables de la víctima
edad,
sexo,
nacionalidad
)
library(dplyr)
base_agrupada <- base_mod %>%
group_by(circuito) %>%
summarise(
total_homicidios = n(), # Aquí creamos la variable que CUENTA los homicidios
# Creamos variables proporcionales para ver correlaciones
# Ejemplo: % de homicidios con arma de fuego
pct_arma_fuego = sum(arma == "Arma de fuego", na.rm = TRUE) / n(),
# Ejemplo: % de víctimas hombres
pct_hombres = sum(sexo == "Hombre", na.rm = TRUE) / n(),
# Ejemplo: Edad promedio de las víctimas en ese circuito
edad_promedio = mean(as.numeric(edad), na.rm = TRUE)
) %>%
filter(!is.na(circuito) & circuito != "") # Filtrar nulos
# 2. Ver la correlación de Pearson entre el número de homicidios y estas variables
correlaciones <- cor(base_agrupada %>% select(total_homicidios, pct_arma_fuego, pct_hombres, edad_promedio),
use = "complete.obs")
print(correlaciones)
View(base_mod)
radio_espacial <- 500
ventana_temporal <- 7
base_con_vecinos<-base_mod %>%
mutate(
n_vecinos_proximos = sapply(1:n(), function(i) {
# Punto actual
punto <- base_mod[i, ]
# Filtrar potenciales vecinos:
# Mismo circuito (opcional para velocidad) y dentro del rango de tiempo
vecinos <- base_mod %>%
filter(
abs(as.numeric(difftime(fecha_infraccion, punto$fecha_infraccion, units = "days"))) <= ventana_temporal,
id != punto$id # Suponiendo que tienes un ID único
)
# Calcular distancias físicas de esos vecinos temporales
distancias <- st_distance(punto, vecinos)
# Contar cuántos están dentro del radio
sum(as.numeric(distancias) <= radio_espacial)
})
)
base_sf <- st_as_sf(base_mod, coords = c("longitud", "latitud"), crs = 4326) %>%
st_transform(32717)
base_con_vecinos<-base_sf %>%
mutate(
n_vecinos_proximos = sapply(1:n(), function(i) {
# Punto actual
punto <- base_sf[i, ]
# Filtrar potenciales vecinos:
